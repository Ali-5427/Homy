{
  "name": "den",
  "productName": "Den",
  "version": "1.0.0",
  "description": "A calm, visual desktop application for finding and safely reviewing local files across macOS and Windows.",
  "author": "Den Team",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js release",
    "lint": "tsc --noEmit",
    "desktop:build:mac": "vite build && electron-builder --mac --config electron-builder.json5",
    "desktop:build:win": "vite build && electron-builder --win --config electron-builder.json5",
    "desktop:build:all": "vite build && electron-builder -mw --config electron-builder.json5"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "electron": "34.0.0",
    "electron-builder": "^25.1.8"
  }
}
